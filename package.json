{
  "name": "clarix-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "node mock/dev.mjs",
    "mock": "node mock/server.mjs",
    "build": "ng build",
    "build:demo": "ng build -c demo && node mock/browser/build-sw.mjs dist/demo/browser",
    "build:single": "npm run build:demo && node mock/browser/build-single.mjs dist/demo/browser dist/Clarix-Prototype.html __CLARIX_DEMO__",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.6.0",
    "@angular/animations": "^21.2.7",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "apexcharts": "^5.13.0",
    "lucide-angular": "^1.0.0",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "autoprefixer": "^10.4.27",
    "buffer": "^6.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "fflate": "^0.8.3",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.9",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
